# Copy to .env (git-ignored). Same variable names as the peloton-to-garmin sync workflow secrets.
P2G_PELOTON__EMAIL=you@example.com
P2G_PELOTON__PASSWORD=
STUDIO_INSTRUCTOR=Becs Gentry
# Optional narrowing: text that must appear on the class card
STUDIO_DISCIPLINE=Tread
#STUDIO_CLASS_TIME=7:00 AM
#STUDIO_CLASS_DAY=Sat
# Deeplink to the schedule week to open after login (find via --discover)
#STUDIO_SCHEDULE_URL=
STUDIO_PRESTART_MINUTES=5
STUDIO_POLL_SECONDS=240
STUDIO_POLL_INTERVAL=0.75
STUDIO_WAITLIST=false
# Optional: POST a one-line result here (ntfy.sh topic, Slack webhook, ...)
#NOTIFY_URL=https://ntfy.sh/your-private-topic
# Only needed where Playwright's own browser download is unavailable
#PLAYWRIGHT_CHROMIUM_PATH=/opt/pw-browsers/chromium
