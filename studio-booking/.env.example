# Copy to .env (git-ignored) for run.sh. Same credential names as the peloton-to-garmin sync workflow secrets.
P2G_PELOTON__EMAIL=you@example.com
P2G_PELOTON__PASSWORD=

STUDIO_INSTRUCTOR=Becs Gentry
STUDIO_INSTRUCTOR_ID=127606
# Optional narrowing (all must match): text in the class name, start time, weekday
#STUDIO_CLASS_NAME=Run
#STUDIO_CLASS_TIME=7:30 AM
#STUDIO_CLASS_DAY=Sat
# Override the class-date window instead of release day + 35 days .. + 39 days
#STUDIO_WINDOW_START=2026-11-19
#STUDIO_WINDOW_END=2026-11-23

STUDIO_PRESTART_MINUTES=5
STUDIO_POLL_SECONDS=300
STUDIO_POLL_INTERVAL=0.3
STUDIO_WAITLIST=false
# true = book with a class credit/membership on the account, false = $35 drop-in purchase
STUDIO_MEMBERSHIP=false

# Persistent Chromium profile so a one-time manual login (incl. any bot challenge) is reused by cron runs
STUDIO_PROFILE_DIR=./profile
# Optional: POST a one-line result here (ntfy.sh topic, Slack webhook, ...)
#NOTIFY_URL=https://ntfy.sh/your-private-topic
# Only where Playwright's own browser download is unavailable
#PLAYWRIGHT_CHROMIUM_PATH=/opt/pw-browsers/chromium
